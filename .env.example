# Use a long random value in production.
SECRET_KEY=replace-with-a-long-random-secret

# Local development: leave DATABASE_URL empty to use DATA_DIR/physics_hub.db.
# Production: use a persistent PostgreSQL database, for example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=

# IMPORTANT: on hosting platforms, point DATA_DIR and UPLOAD_FOLDER to a persistent disk/volume.
DATA_DIR=./data
UPLOAD_FOLDER=./data/uploads

MAX_UPLOAD_MB=20
# Set these to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0
REMEMBER_COOKIE_SECURE=0
